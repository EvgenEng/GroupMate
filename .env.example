# ─── Telegram ──────────────────────────────────────────────
BOT_TOKEN=                 # @BotFather → /newbot → токен
OWNER_ID=                  # ваш Telegram ID (узнать: напишите боту /id)
GROUP_CHAT_ID=             # ID группы (добавьте бота в группу и напишите там /id)
TELEGRAM_PROXY=            # необязательно: socks5://user:pass@host:port или http://host:port

# ─── Нейросеть (любой OpenAI-совместимый сервис) ───────────
# Основной: Google Gemini — бесплатный и самый щедрый лимит (нужен VPN из РФ).
# Ключ: https://aistudio.google.com/apikey
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# Запасной (если основной упал или кончился лимит): OpenRouter, бесплатные модели «:free».
# Ключ: https://openrouter.ai/keys   Модели: https://openrouter.ai/models?q=free
LLM_FALLBACK_API_URL=https://openrouter.ai/api/v1/chat/completions
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=

LLM_DAILY_CAP=30           # сколько вопросов в сутки может задать один человек (владельцу — без лимита)
LLM_SYSTEM_PROMPT_FILE=config/prompt.txt   # характер бота; нет файла — нейтральный по умолчанию

# ─── Погода (Open-Meteo, бесплатно и без ключа) ────────────
WEATHER_ENABLED=true
WEATHER_MORNING_TIME=07:00         # сводка на сегодня
WEATHER_EVENING_TIME=21:00         # сводка на завтра
WEATHER_ALERTS_ENABLED=true        # предупреждать, если погода резко меняется
WEATHER_ALERTS_FROM_HOUR=9
WEATHER_ALERTS_TO_HOUR=21
WEATHER_ALERTS_EVERY_MIN=120
# Первая точка — главная (подробно), остальные — краткой строкой. Формат: Название:широта:долгота;...
# Пусто = Москва + 4 направления Подмосковья.
WEATHER_LOCATIONS=

# ─── Дни рождения ──────────────────────────────────────────
BIRTHDAY_TIME=10:00

# ─── Группа и заказы ───────────────────────────────────────
WELCOME_ENABLED=true
ORDER_REMINDERS_ENABLED=true
ORDER_REMINDER_WEEKDAYS=пт         # дни обычного напоминания: пн,вт,ср,чт,пт,сб,вс
ORDER_REMINDER_TIME=12:00          # перед праздниками бот напомнит сам (config/holidays.json)
CATALOG_PATH=config/catalog.json
HOLIDAYS_PATH=config/holidays.json

# ─── Прочее ────────────────────────────────────────────────
TIMEZONE=Europe/Moscow
DB_PATH=data/bot.db
